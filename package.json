{
  "name": "agent-tutor",
  "version": "0.1.0",
  "description": "The agent-agnostic AI tutor skill that writes into your Obsidian vault: profiles how you learn, builds phased plans, teaches from your own material, quizzes with honest feedback, and schedules spaced-repetition reviews.",
  "keywords": [
    "pi-package",
    "agent-skills",
    "learning",
    "tutor",
    "spaced-repetition",
    "obsidian",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohamed-El-Sharqawy/agent-tutor.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "scripts": {
    "sync": "node scripts/sync-skills.mjs",
    "check": "node scripts/validate.mjs"
  }
}
