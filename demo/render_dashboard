#!/usr/bin/env bash
# demo/render_dashboard — terminal epilogue: what the Dashboard looks like
# in Obsidian after the session. Pre-rendered with the real example files.
#
# The donut matches examples/vault/Learning/Rust/assets/progress.svg
# and the palette of the visualize skill: accent cyan #22d3ee, neutrals.
# Update this file when the example vault changes.

B=$'\033[1;36m'
G=$'\033[1;32m'
Y=$'\033[1;33m'
D=$'\033[2m'
M=$'\033[1;35m'
N=$'\033[0m'

printf '\n%s── Learning Dashboard — as it renders in Obsidian ──%s\n\n' "$M" "$N"

# donut: 7% of 360deg = 25deg arc; chars: 25/360*28 ≈ 2 filled
printf '   %s████%s%s────────────────────────%s  %s7%% %s Rust — 1/14 topics, Phase 1 of 4\n' \
  "$B" "$N" "$D" "$N" "$B" "$N"

# completion pie as a stacked bar
printf '   %s██%s%s██████████████████████%s  %s▂▂▂ Topic completion: 1 done · 13 remaining%s\n' \
  "$B" "$N" "$D" "$N" "$B" "$N"

# review forecast as spark bars
printf '   %sReviews due — next 7 days%s\n' "$B" "$N"
printf '     %sThu ▁ Fri ▂ Sat · Sun · Mon ▁ Tue · Wed ·%s   %s1 note due tomorrow (+1d)%s\n' "$B" "$N" "$D" "$N"

printf '\n   %splan.md  notes/01-ownership-model.md  quizzes/  logs/  assets/progress.svg%s\n' "$D" "$N"
printf '%s   the dashboard updates itself — charts always match the tables.%s\n\n' "$D" "$N"
